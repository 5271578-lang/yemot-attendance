# העתיקו לקובץ .env (או הגדירו את הערכים בלוח הבקרה של שירות האחסון)

# סיסמה סודית שהמערכת הטלפונית שולחת בכל בקשה (אותה מילה כמו ב-api_add_0 בקובץ ext.ini)
IVR_SECRET=choose-a-long-random-word

# גישה ל-API של NBS: מספר המערכת:סיסמת הניהול, או מפתח API מממשק חומת האש
NBS_TOKEN=0770000000:password

# אופציונלי: מזהה קמפיין שממנו נלקחות הגדרות חיוג חוזר, וזיהוי יוצא
NBS_TEMPLATE_ID=
NBS_CALLER_ID=

# כניסה לממשק הניהול
ADMIN_USER=admin
ADMIN_PASSWORD=choose-a-strong-password

# 1 = לבקש תמיד מספר עובד וקוד, גם מטלפון מזוהה
REQUIRE_PIN=0

# 1 = להתקשר לנמענים כשמשאירים להם הודעה (שיחה קולית, אף פעם לא SMS)
NOTIFY_BY_CALL=1

# התיקייה במערכת הטלפונית שבה נשמרות ההקלטות
RECORD_FOLDER=/8

TIMEZONE=Asia/Jerusalem
DB_PATH=attendance.db
